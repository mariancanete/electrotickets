# Public site URL. Use your Vercel URL first, then https://electrotickets.com.ar when the domain is live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=event-flyers

# Admin simple. Cambiá estos valores antes de deployar.
ELECTROTICKETS_ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-long-random-secret


# Contacto público
# Formato recomendado para Argentina: 54911XXXXXXXX. Sin espacios, + ni guiones.
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_NAME=ElectroTickets
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/LVWQjAe4r0EAtprDPObqnH?mode=gi_t
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/electrotickets

# Optional analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
